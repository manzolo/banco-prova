{
  "name": "banco-prova",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Banco di prova — simulatore di componenti elettronici e multimetro: misura, sbaglia senza danni, impara",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.ts",
    "test": "node --test tests/*.test.ts",
    "test-e2e": "node tests/e2e.ts",
    "test-all": "npm run build && npm test && npm run test-e2e"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "playwright": "1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
